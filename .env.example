AGENCY_NAME="Wanderlux Travel"

# Required for the agent to actually reason. Without it the app still runs: pages
# render, the database records everything, and the independent guardrail check
# works — only the model call is unavailable.
ANTHROPIC_API_KEY=

ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=8000

# Leave unset locally to fall back to a SQLite file in ./data/.
DATABASE_URL=

# Signs the session cookie. Set your own random value in production.
SECRET_KEY=dev-only-not-for-production

RETRIEVAL_TOP_K=4
